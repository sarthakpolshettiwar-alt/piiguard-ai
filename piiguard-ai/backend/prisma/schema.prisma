generator client {
  provider = "prisma-client-js"
}

// LOCAL DEVELOPMENT: Using SQLite for instant setup
// TO SWITCH TO SUPABASE: Change provider to "postgresql" and update DATABASE_URL in .env
datasource db {
  provider = "sqlite"
  url      = "file:./piiguard.db"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("user")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model TokenEvent {
  id               String   @id @default(uuid())
  piiType          String
  tokenId          String
  action           String
  encryptedMapping String?
  timestamp        DateTime @default(now())
}

model ThreatEvent {
  id        String   @id @default(uuid())
  type      String
  severity  String
  payload   String
  ipAddress String?
  blocked   Boolean  @default(true)
  timestamp DateTime @default(now())
}

model ApiMetric {
  id         String   @id @default(uuid())
  endpoint   String
  method     String
  statusCode Int
  latency    Float
  timestamp  DateTime @default(now())
}
